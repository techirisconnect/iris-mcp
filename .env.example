# Copy to .env and fill in. Never commit .env.

# --- Zoho (Canada data center) ---
Z_CLIENT_ID=
Z_CLIENT_SECRET=
Z_ACCOUNTS_BASE=https://accounts.zohocloud.ca
Z_API_BASE=https://www.zohoapis.ca

# One refresh token per product (different scopes). Generate each with a Self Client.
# CRM: ZohoCRM.modules.READ, ZohoCRM.settings.READ
Z_REFRESH_TOKEN=
# Cliq: ZohoCliq.Channels.READ, ZohoCliq.Messages.READ
CLIQ_OAUTH_REFRESH_TOKEN=
CLIQ_BASE_URL=https://cliq.zohocloud.ca
# WorkDrive: WorkDrive.files.READ, WorkDrive.team.READ
Z_WORKDRIVE_REFRESH_TOKEN=
# Sign: ZohoSign.documents.READ
# Projects: ZohoProjects.portals.READ, ZohoProjects.projects.READ, ZohoProjects.tasks.READ, ZohoProjects.tasklists.READ
# If left empty, Sign and Projects reuse Z_REFRESH_TOKEN, so generate that token with these scopes too.
Z_SIGN_REFRESH_TOKEN=
PROJECTS_REFRESH_TOKEN=
# Required for Projects (same value as the backends' PROJECTS_PORTAL_ID)
PROJECTS_PORTAL_ID=
# Optional
WORKDRIVE_TEAM_ID=

# --- Database (Postgres, read-only role) ---
# Create the role with sql/create-readonly-role.sql, then use its connection string
# (Supabase: Settings > Database > Connection string, user iris_mcp_ro.<project-ref> on the pooler).
DATABASE_URL_READONLY=
# Optional comma separated allowlist (default: properties, rental_managers, leases, tenants, maintenance_requests, property_tenant_waitlist)
DB_ALLOWED_TABLES=
