# Copy to .env and fill in. Never commit .env.

# --- Zoho (Canada data center) ---
Z_CLIENT_ID=
Z_CLIENT_SECRET=
Z_ACCOUNTS_BASE=https://accounts.zohocloud.ca
Z_API_BASE=https://www.zohoapis.ca

# One refresh token per product (different scopes). Generate each with a Self Client.
# CRM: ZohoCRM.modules.READ, ZohoCRM.settings.READ
Z_REFRESH_TOKEN=
# Cliq: ZohoCliq.Channels.READ, ZohoCliq.Messages.READ
CLIQ_OAUTH_REFRESH_TOKEN=
CLIQ_BASE_URL=https://cliq.zohocloud.ca
# WorkDrive: WorkDrive.files.READ, WorkDrive.team.READ
Z_WORKDRIVE_REFRESH_TOKEN=
# Sign: ZohoSign.documents.READ
# Projects: ZohoProjects.portals.READ, ZohoProjects.projects.READ, ZohoProjects.tasks.READ, ZohoProjects.tasklists.READ
# If left empty, Sign and Projects reuse Z_REFRESH_TOKEN, so generate that token with these scopes too.
Z_SIGN_REFRESH_TOKEN=
PROJECTS_REFRESH_TOKEN=
# Required for Projects (same value as the backends' PROJECTS_PORTAL_ID)
PROJECTS_PORTAL_ID=
# Optional
WORKDRIVE_TEAM_ID=

# --- Write tools (Level A, docs/SPEC.md section 4). OFF unless WRITES_ENABLED=true ---
WRITES_ENABLED=
# ONE separate refresh token, scopes CREATE only (never DELETE):
# ZohoCRM.modules.notes.CREATE, ZohoCRM.modules.tasks.CREATE, ZohoProjects.tasks.CREATE,
# WorkDrive.files.CREATE, ZohoCliq.Webhooks.CREATE (Cliq scope still to confirm live)
# Writes never fall back to the read tokens.
Z_WRITE_REFRESH_TOKEN=
# Cliq channels (unique names, comma separated) where Claude may post
CLIQ_WRITE_CHANNELS=

# --- Level B writes (update/create with two-step confirmation). OFF unless WRITES_B_ENABLED=true ---
WRITES_B_ENABLED=
# SECOND token, never DELETE. Scopes: ZohoCRM.modules.leads.UPDATE, ZohoCRM.modules.contacts.UPDATE,
# ZohoCRM.modules.leads.CREATE, ZohoCRM.modules.contacts.CREATE, ZohoProjects.tasks.UPDATE
Z_WRITE_B_REFRESH_TOKEN=
# Secret that signs the confirmations (falls back to ZOHO_LOGIN_CLIENT_SECRET / Z_CLIENT_SECRET)
CONFIRM_SECRET=
# Optional overrides of the fields Claude may change (comma separated API names)
CRM_UPDATE_FIELDS_LEADS=
CRM_UPDATE_FIELDS_CONTACTS=

# --- Remote mode only (node src/http.js) ---
# Public https URL of the deployed server, no trailing slash
BASE_URL=
# Zoho "Server-based Application" client used only to log people in (redirect URI: BASE_URL/zoho/callback)
ZOHO_LOGIN_CLIENT_ID=
ZOHO_LOGIN_CLIENT_SECRET=
# Comma separated emails that are always allowed and are admins (also default AUDIT_ADMINS)
ADMIN_EMAILS=
# Role iris_mcp_auth from sql/create-auth-tables.sql (pooler, port 6543)
AUTH_DATABASE_URL=

# --- Audit log ---
# Always written to a JSON-lines file (default: logs/audit.jsonl, git-ignored).
AUDIT_LOG_FILE=
# Optional second destination: Postgres table, role from sql/create-audit-table.sql (INSERT/SELECT only)
AUDIT_DATABASE_URL=
# Who is the caller in local (stdio) mode; defaults to the OS user. Remote mode uses the logged-in user.
IRIS_USER=
# Comma separated users allowed to run audit_query
AUDIT_ADMINS=

# --- Database (Postgres, read-only role) ---
# Create the role with sql/create-readonly-role.sql, then use its connection string
# (Supabase: Settings > Database > Connection string, user iris_mcp_ro.<project-ref> on the pooler).
DATABASE_URL_READONLY=
# Optional comma separated allowlist (default: properties, rental_managers, leases, tenants, maintenance_requests, property_tenant_waitlist)
DB_ALLOWED_TABLES=
# Schema to read. Empty = public (the real tables). "mcp" = the views of sql/create-mcp-views.sql (recommended for the team;
# then DB_ALLOWED_TABLES defaults to properties, property_managers, leases, tenants, maintenance_requests, waitlist_candidates).
DB_SCHEMA=
# Optional JSON whitelist of columns per table, e.g. {"properties":["name","city","rent_amount"]}.
# Without an entry a table shows its readable columns minus sensitive names, integration ids (zoho/buildium/desk/vendor...),
# reference columns (*_id, *_by, assigned_to) and foreign keys. Whitelist wins; use it to show less (or to re-show an id).
DB_EXPOSED_COLUMNS=
# Max rows per db_query (default 100) and rows one person may read through db_query per rolling 24 h (default 1000, 0 = off).
DB_MAX_ROWS=
DB_DAILY_ROW_LIMIT=

# --- Instructions for Claude ---
# Optional extra rules appended to the built-in ones (which never describe or infer the structure or
# technology of IRIS systems). Plain text; the base rules cannot be removed from here.
IRIS_MCP_EXTRA_INSTRUCTIONS=
